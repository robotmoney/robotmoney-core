[Unit]
Description=Robot Money Fusion watchdog supervisor
After=network-online.target fusion-alert-sink.service
Wants=network-online.target fusion-alert-sink.service

[Service]
Type=simple
EnvironmentFile=/etc/fusion-watchdog.env
ExecStart=/opt/fusion-stage/fusion-watchdog-supervisor.sh
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
