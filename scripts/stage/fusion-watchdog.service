# systemd unit for scripts/stage/fusion-watchdog-supervisor.sh (issue #1378).
#
# Restart=always keeps the supervisor up; the supervisor keeps the watchdog up
# and pages when the watchdog is not proving it is watching. If systemd itself
# gives up (StartLimitBurst exhausted -- e.g. the supervisor exits on a bad
# environment file), OnFailure= pages so that is an incident, not a quiet line
# in the journal. StartLimit* live in [Unit]: that is where systemd reads them.
#
# Install: scripts/stage/install-fusion-watchdog.sh.
# Runbook: docs/operations/watchdog-liveness.md.
[Unit]
Description=Robot Money Fusion watchdog supervisor
After=network-online.target fusion-alert-sink.service
Wants=network-online.target fusion-alert-sink.service
StartLimitIntervalSec=300
StartLimitBurst=10
OnFailure=fusion-watchdog-failed.service

[Service]
Type=simple
EnvironmentFile=/etc/fusion-watchdog.env
ExecStart=/opt/fusion-stage/fusion-watchdog-supervisor.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
