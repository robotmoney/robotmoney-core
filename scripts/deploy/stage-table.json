      "manifest": "deployments/<chain>/protocol-asset-vault.json",
      "manifestNotes": "Single-vault redeploy into a live deployment (issue 1796), run by the redeploy-vault verb only: no frozen count, no stage. The script deploys the vault closed, unregistered and unlinked, and hands ADMIN_ROLE to the timelock and EMERGENCY_ROLE to the emergency key. The Safe links the registry (set-once, the timelock's ADMIN_ROLE), registers it, moves router eligibility and retires the old vault through the timelock in one batch (govern row redeploy-vault). No vault deploy script links the registry (core S5).",
      "libraries": [
        "tick_math"
      ],
      "create2Libraries": [
        "BasketAssetConfigGuard",
        "TwapTickMath",
        "BasketViews"
      ]
    }
