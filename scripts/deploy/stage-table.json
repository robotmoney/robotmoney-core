{
  "version": 1,
  "systems": {
    "vaults": {
      "description": "The treasury product: vaults, registry, router, governance, receipt and the timelock handover. It needs no gateway.",
      "stages": [
        "libs",
        "vault",
        "registry",
        "router",
        "receipt",
        "governance",
        "proto",
        "rwa",
        "hard",
        "timelock"
      ],
      "requires": []
    },
    "gateway": {
      "description": "The rmpc gateway system: RobotMoneyGateway and its handover. It reads the vaults system's addresses and nothing else of it.",
      "stages": [
        "gateway",
        "gateway-handover"
      ],
      "requires": [
        "vaults"
      ]
    },
    "fund": {
      "description": "Deploy 4 (owner exception 2026-11-12): the one-vault prototype (contracts/test/prototype/src) as a rehearsal on 8453. RobotMoneyFund, its rebalancer, its governance, its flow queue and its own receipt register, Safe and timelock. It reads nothing of the vaults or gateway systems.",
      "stages": [
        "fund-libs",
        "fund-receipt",
        "fund",
        "rebalancer",
        "fund-governance",
        "queue",
        "fund-wiring",
        "fund-timelock"
      ],
      "requires": [],
      "upgradeAuthorityStage": "fund-timelock"
    }
  },
  "stages": [
