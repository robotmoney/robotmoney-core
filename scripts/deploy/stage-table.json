  "govern": {
    "stage": 13,
    "description": "After the timelock handover the only mainnet operation is the unpause of each of the four vaults (rmUSDC, rmPROTO, rmAGENT, rmRWA), all four deployed paused: one timelock operation per unpause, all scheduled in one sitting, one 48 hour wait, then executed. Vault setters, router eligibility and router default weights are deploy-time configuration set by the deployer in stages 4 to 10, before the handover, and asserted by the verify stage. The governance stage deploys the weight setter (RouterGovernance) with no voting surface (issue 1698): there is no voting by anyone. Router weights change on demand through the apply-receipt row (core 1696), one RouterGovernance.applyReceipt call through the timelock, never in stage 13. update-delay, batch and cancel are Twin-only demonstrations of the Safe tool and are refused on 8453.",
    "mainnetRows": [
      "unpause-USDC",
      "unpause-PROTO",
      "unpause-AGENT",
      "unpause-RWA"
    ],
    "twinOnlyRows": [
      "update-delay",
      "batch",
      "cancel"
    ]
  },
  "redeploys": [
    {
      "vault": "PROTO",
      "script": "contracts/script/RedeployProtocolAssetVault.s.sol:RedeployProtocolAssetVault",
      "requiredEnv": [
        "ADMIN_ADDRESS",
        "SWAP_ROUTER",
        "REGISTRY_ADDRESS",
        "TIMELOCK_ADDRESS",
        "EMERGENCY_ADDRESS",
        "TVL_CAP",
