{
  "version": 1,
  "stages": [
    {
      "name": "libs",
      "kind": "forge",
      "script": "contracts/script/DeployLibs.s.sol:DeployLibs",
      "requiredEnv": [
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/libs.json",
      "libraries": [],
      "vault": null
    },
    {
      "name": "recorder",
      "kind": "forge",
      "script": "contracts/script/DeployUniswapV4PriceRecorder.s.sol:DeployUniswapV4PriceRecorder",
      "requiredEnv": [
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/recorder.json",
      "manifestNotes": "The permissionless Uniswap V4 price recorder for the RM/USDC pool (core 1676). It runs right after libs so the 1800 s price history accumulates while the other stages run. The runner waits for a full window of history before the agent stage. No role is involved.",
      "libraries": [],
      "vault": null
    },
    {
      "name": "vault",
      "kind": "forge",
      "script": "contracts/script/DeployVault.s.sol:DeployVault",
      "requiredEnv": [
        "ADMIN_ADDRESS",
        "FEE_RECIPIENT",
        "TVL_CAP",
        "PER_DEPOSIT_CAP",
        "SEED_SHARE_RECEIVER",
        "SEED_DEPOSIT_USDC",
        "EXIT_FEE_BPS",
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/vault.json",
      "manifestNotes": "Seed fields: seed_share_receiver (SEED_SHARE_RECEIVER), seed_shares (minted to the receiver) and deployer_share_balance_after (must be 0). Verify asserts the deployer holds zero shares and the receiver holds the seed shares.",
      "libraries": [],
      "vault": "USDC"
    },
    {
      "name": "registry",
      "kind": "forge",
      "script": "contracts/script/DeployVaultRegistry.s.sol:DeployVaultRegistry",
      "requiredEnv": [
        "ADMIN_ADDRESS",
        "VAULT_ADDRESS",
        "VAULT_NAME",
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/registry.json",
      "libraries": [],
      "vault": null
    },
    {
      "name": "router",
      "kind": "forge",
      "script": "contracts/script/DeployPortfolioRouter.s.sol:DeployPortfolioRouter",
      "requiredEnv": [
        "ADMIN_ADDRESS",
        "REGISTRY_ADDRESS",
        "VAULT_ADDRESS",
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/router.json",
      "libraries": [],
      "vault": null
    },
    {
      "name": "gateway",
      "kind": "forge",
      "script": "contracts/script/DeployGateway.s.sol:DeployGateway",
      "requiredEnv": [
        "ADMIN_ADDRESS",
        "PAUSER_ADDRESS",
        "SHARE_RECEIVER_ADDRESS",
        "VAULT_ADDRESS",
        "ROUTER_ADDRESS",
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/gateway.json",
      "libraries": [],
      "vault": null
    },
    {
      "name": "governance",
      "kind": "forge",
      "script": "contracts/script/DeployRouterGovernance.s.sol:DeployRouterGovernance",
      "requiredEnv": [
        "ADMIN_ADDRESS",
        "ROUTER_ADDRESS",
        "QUORUM_THRESHOLD",
        "VOTING_PERIOD",
        "EXECUTION_DELAY",
        "VOTER_ADDRESSES",
        "VOTER_POWER",
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/governance.json",
      "libraries": [],
      "vault": null
    },
    {
      "name": "ic-policy",
      "kind": "forge",
      "script": "contracts/script/DeployInvestmentCommitteePolicy.s.sol:DeployInvestmentCommitteePolicy",
      "requiredEnv": [
        "ADMIN_ADDRESS",
        "GATEWAY_ADDRESS",
        "RECEIPT_ADMIN_ADDRESS",
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/ic-policy.json",
      "libraries": [],
      "vault": null
    },
    {
      "name": "proto",
      "kind": "forge",
      "script": "contracts/script/DeployProtocolAssetVault.s.sol:DeployProtocolAssetVault",
      "requiredEnv": [
        "ADMIN_ADDRESS",
        "SWAP_ROUTER",
        "REGISTRY_ADDRESS",
        "TVL_CAP",
        "PER_DEPOSIT_CAP",
        "FEE_RECIPIENT",
        "EXIT_FEE_BPS",
        "NAV_DEVIATION_BPS",
        "MIN_POOL_LIQUIDITY",
        "ROUTER_DEFAULT_BPS",
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/protocol-asset-vault.json",
      "libraries": [
        "tick_math"
      ],
      "vault": "PROTO"
    },
    {
      "name": "agent",
      "kind": "forge",
      "script": "contracts/script/DeployAgentTokenVault.s.sol:DeployAgentTokenVault",
      "requiredEnv": [
        "ADMIN_ADDRESS",
        "SWAP_ROUTER",
        "RECORDER_ADDRESS",
        "REGISTRY_ADDRESS",
        "TVL_CAP",
        "PER_DEPOSIT_CAP",
        "FEE_RECIPIENT",
        "EXIT_FEE_BPS",
        "NAV_DEVIATION_BPS",
        "MIN_POOL_LIQUIDITY",
        "ROUTER_DEFAULT_BPS",
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/agent-token-vault.json",
      "libraries": [
        "tick_math"
      ],
      "vault": "AGENT"
    },
    {
      "name": "rwa",
      "kind": "forge",
      "script": "contracts/script/DeployRwaBasketVault.s.sol:DeployRwaBasketVault",
      "requiredEnv": [
        "ADMIN_ADDRESS",
        "SWAP_ROUTER",
        "REGISTRY_ADDRESS",
        "TVL_CAP",
        "PER_DEPOSIT_CAP",
        "FEE_RECIPIENT",
        "EXIT_FEE_BPS",
        "NAV_DEVIATION_BPS",
        "MIN_POOL_LIQUIDITY",
        "ROUTER_DEFAULT_BPS",
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/rwa-basket-vault.json",
      "libraries": [
        "tick_math"
      ],
      "vault": "RWA"
    },
    {
      "name": "timelock",
      "kind": "forge",
      "script": "contracts/script/DeployTimelock.s.sol:DeployTimelock",
      "requiredEnv": [
        "AGENT_ADDRESSES",
        "VAULT_ADDRESSES",
        "GATEWAY_ADDRESS",
        "REGISTRY_ADDRESS",
        "ROUTER_ADDRESS",
        "GOVERNANCE_ADDRESS",
        "SAFE_ADDRESS",
        "SAFE_OWNERS",
        "SAFE_THRESHOLD",
        "EMERGENCY_ADDRESS",
        "TIMELOCK_MIN_DELAY",
        "IC_POLICY_ADDRESS",
        "CONSENSUS_RECEIPT_ADDRESS",
        "RECEIPT_ADMIN_ADDRESS",
        "DEPLOYMENT_OUT"
      ],
      "optionalEnv": [
        "EXPECTED_CHAIN_ID"
      ],
      "manifest": "deployments/<chain>/timelock.json",
      "libraries": [],
      "vault": null
    }
  ],
  "govern": {
    "stage": 13,
    "description": "After the timelock handover the only mainnet operation is the unpause of each of the four vaults (rmUSDC, rmPROTO, rmAGENT, rmRWA), all four deployed paused: one timelock operation per unpause, all scheduled in one sitting, one 48 hour wait, then executed. Vault setters, router eligibility and router default weights are deploy-time configuration set by the deployer in stages 4 to 10, before the handover, and asserted by the verify stage. The governance stage's VOTER_*, QUORUM_THRESHOLD, VOTING_PERIOD and EXECUTION_DELAY are constructor arguments of today's RouterGovernance bytecode, not governance: there is no voting by anyone. Router weights change on demand through the apply-receipt row (core 1696), never in stage 13. update-delay, batch and cancel are Twin-only demonstrations of the Safe tool and are refused on 8453.",
    "mainnetRows": [
      "unpause-USDC",
      "unpause-PROTO",
      "unpause-AGENT",
      "unpause-RWA"
    ],
    "twinOnlyRows": [
      "update-delay",
      "batch",
      "cancel"
    ]
  },
  "vaults": [
    {
      "key": "USDC",
      "stage": "vault",
      "artifact": "RobotMoneyVault",
      "manifest": "deployments/<chain>/vault.json"
    },
    {
      "key": "PROTO",
      "stage": "proto",
      "artifact": "ProtocolAssetVault",
      "manifest": "deployments/<chain>/protocol-asset-vault.json"
    },
    {
      "key": "AGENT",
      "stage": "agent",
      "artifact": "AgentTokenVault",
      "manifest": "deployments/<chain>/agent-token-vault.json"
    },
    {
      "key": "RWA",
      "stage": "rwa",
      "artifact": "RwaBasketVault",
      "manifest": "deployments/<chain>/rwa-basket-vault.json"
    }
  ],
  "libraries": [
    {
      "name": "tick_math",
      "artifact": "TickMath",
      "manifestKey": "tick_math",
      "path": "contracts/lib/TickMath.sol"
    }
  ],
  "artifacts": {
    "gateway": "RobotMoneyGateway",
    "router": "PortfolioRouter",
    "registry": "VaultRegistry",
    "governance": "RouterGovernance",
    "timelock": "TimelockController",
    "icPolicy": "InvestmentCommitteePolicy",
    "receipt": "ConsensusRecommendationReceipt",
    "recorder": "UniswapV4PriceRecorder",
    "v4Adapter": "UniswapV4SwapAdapter"
  }
}
