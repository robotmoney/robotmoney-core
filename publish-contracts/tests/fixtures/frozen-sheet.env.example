# Frozen sheet for publish contracts (runbook section 4). Copy to evidence/<run-id>/frozen-sheet.env and fill in.
# The sheet is DATA. publish-contracts parses it as a whitelist and never sources it. One NAME=value per line.
# This example uses obvious placeholder addresses (0x...a001 and so on). It passes the real parser so a typo in a name fails CI.
#   - NO SECRETS in this file: no private keys, no keystore passphrases. A name such as PRIVATE_KEY is refused.
#   - YES and CONFIRM are never sheet lines. They come from the caller environment, and YES is refused on chain id 8453.
#   - REHEARSAL, ALLOW_SHORT_TIMELOCK_DELAY, SAFE_ADDRESS and the stage outputs (REGISTRY_ADDRESS and so on) are refused.
#   - Every name below is required. Nothing has a default and nothing is skipped silently.
#   - `bun run rehearsal keys` prints the role and Safe owner lines from throwaway keystores (Twin chain only). The Twin chain is a pinned lazy fork
#     of real Base state (core's twin-fork tool). `rehearsal fund-gas` and `rehearsal fund-usdc` fund these wallets there, and the govern waits are warped.
#   - On 8453 the Safe owners are three independent production keys. At most one is a credentials persona (runbook section 3).
#   - Production sheet: seed 1 USDC, tiny per-vault caps, TIMELOCK_MIN_DELAY 172800 or more. Commit it under deployments/base-mainnet/.
# Rehearsal and production use the same names. Only the values differ (chain id, delay, caps, keys).

# --- chain: both must equal `cast chain-id` of the RPC (918453 on the Twin chain, 8453 on Base) ---
CHAIN_ID=918453
EXPECTED_CHAIN_ID=918453

# --- roles. Every address is different. Safe owners are separate from the role keys. ---
ADMIN_ADDRESS=0x000000000000000000000000000000000000a001        # the deployer: fresh, nonce 0, holds nothing after the timelock stage
PAUSER_ADDRESS=0x000000000000000000000000000000000000a002
EMERGENCY_ADDRESS=0x000000000000000000000000000000000000a003
SHARE_RECEIVER_ADDRESS=0x000000000000000000000000000000000000a005
RECEIPT_ADMIN_ADDRESS=0x000000000000000000000000000000000000a001   # must equal ADMIN_ADDRESS: DeployInvestmentCommitteePolicy gives the receipt roles to it, the deployer revokes them in the timelock stage
SAFE_OWNERS=0x000000000000000000000000000000000000c001,0x000000000000000000000000000000000000c002,0x000000000000000000000000000000000000c003
SAFE_THRESHOLD=2                       # 2 .. N-1
SAFE_VERSION=1.4.1                     # optional. 1.4.1 is the only version.

# --- economics ---
FEE_RECIPIENT_ADDRESS=@safe            # the created Safe, or another treasury address. Never the deployer.
SEED_DEPOSIT_USDC=1000000              # rmUSDC only: 1 USDC in 6-decimal units
SWAP_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481   # Uniswap V3 SwapRouter02 on Base, the basket vaults' swap router (core SWAP_ROUTER)
VAULT_USDC_TVL_CAP=1000000000          # per-vault names carry the vault key: USDC, PROTO, AGENT, RWA
VAULT_USDC_PER_DEPOSIT_CAP=100000000
VAULT_USDC_EXIT_FEE_BPS=0
VAULT_PROTO_TVL_CAP=1000000000
VAULT_PROTO_PER_DEPOSIT_CAP=100000000
VAULT_PROTO_EXIT_FEE_BPS=0
VAULT_PROTO_NAV_DEVIATION_BPS=100
VAULT_PROTO_MIN_POOL_LIQUIDITY=10000000000
VAULT_AGENT_TVL_CAP=1000000000
VAULT_AGENT_PER_DEPOSIT_CAP=100000000
VAULT_AGENT_EXIT_FEE_BPS=0
VAULT_AGENT_NAV_DEVIATION_BPS=400
VAULT_AGENT_MIN_POOL_LIQUIDITY=1000000000
VAULT_RWA_TVL_CAP=1000000000
VAULT_RWA_PER_DEPOSIT_CAP=100000000
VAULT_RWA_EXIT_FEE_BPS=0
VAULT_RWA_NAV_DEVIATION_BPS=100
VAULT_RWA_MIN_POOL_LIQUIDITY=1000000000000

# --- governance ---
TIMELOCK_MIN_DELAY=60                  # 172800 (48 h) or more on chain id 8453. At least 1 elsewhere.
UPGRADE_MODE=frozen                    # issue 1809: the release mode of every core proxy, upgradeable or frozen. Required, no default. frozen freezes upgrades in each proxy's initializer.
# UPGRADE_FREEZE_DEADLINE=2027-01-31T00:00:00Z   # upgradeable only: the proving-period freeze deadline (ISO 8601 UTC). Required for an upgradeable production release on 8453, refused with frozen.

# --- deploy-time router configuration (issue 1520). Set by the deployer in the basket vault stages, before the timelock handover. Lists of vault keys, or the word none. ---
ELIGIBLE_VAULTS=PROTO,AGENT,RWA           # baskets made router-eligible by migrateEligibility in their own stage. rmUSDC is eligible from the router stage.
ROUTER_WEIGHTS=USDC:9500,PROTO:500,AGENT:0,RWA:0   # the router default weights: rmUSDC and each eligible basket, bps summing to 10000. The last eligible basket stage leaves exactly this vector.

# --- govern stage (stage 13). On 8453 the only operation after the handover is the unpause of the four vaults: one timelock operation per vault listed here. ---
GOVERN_UNPAUSE_VAULTS=USDC,PROTO,AGENT,RWA   # which vaults the Safe unpauses: all four (they all deploy paused), as stage 13 does on 8453, all scheduled in one sitting, one 48 hour wait.
GOVERN_NEW_DELAY=3600                  # Twin-only update-delay demonstration target (refused on 8453). 3600 to 2592000, and at least the chain floor.
