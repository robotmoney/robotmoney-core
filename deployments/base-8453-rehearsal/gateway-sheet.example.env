# EXAMPLE sheet for the GATEWAY SYSTEM run of a Base mainnet REHEARSAL (issue 1892): bun publish-contracts/src/cli.ts publish --system gateway --sheet <this sheet>.
# It is a separate, small sheet: the gateway system has no Safe, no treasury name and no agent. The vaults system runs first, from stage-sheet.example.env, and this run reads its manifests.
# PUBLIC ADDRESSES ONLY. Every address below is a PLACEHOLDER. No key, passphrase or keystore path belongs in this file.
# GATEWAY_ADMIN_ADDRESS and GATEWAY_UPGRADE_TIMELOCK have no default and are never the vaults timelock by omission. Which authority holds the production gateway ADMIN_ROLE and which
# nonzero timelock governs the production gateway release is an OPEN decision (docs/architecture.md section 10). A rehearsal names its own explicit values here.
# Any AGENT_ name, SAFE_ name, TIMELOCK_MIN_DELAY or treasury name in this file is refused before any signer or broadcast.
CHAIN_ID=8453
EXPECTED_CHAIN_ID=8453
DEPLOYMENT_KIND=rehearsal
ADMIN_ADDRESS=0x000000000000000000000000000000000000a001        # the deployer of the vaults run: it holds the gateway roles until the gateway-handover stage
PAUSER_ADDRESS=0x000000000000000000000000000000000000a002
SHARE_RECEIVER_ADDRESS=0x000000000000000000000000000000000000a005
UPGRADE_MODE=upgradeable
GATEWAY_ADMIN_ADDRESS=0x000000000000000000000000000000000000a0c1        # PLACEHOLDER: the explicitly configured holder of gateway ADMIN_ROLE and DEFAULT_ADMIN_ROLE after the handover
GATEWAY_UPGRADE_TIMELOCK=0x000000000000000000000000000000000000a0c2     # PLACEHOLDER: the gateway's own nonzero upgrade timelock; it must have code on the chain
