# EXAMPLE sheet for a Base mainnet REHEARSAL (chain 8453, DEPLOYMENT_KIND=rehearsal, a 900 s timelock). Issue 1727, owner decision 2026-10-10.
# A rehearsal tests the full governance end to end on real 8453 contracts: the four unpauses, the committee submitter registration, a REAL recorded consensus receipt, the receipt
# application (releaseReceipt plus the router weights, one timelock batch) and the explicit update-delay, batch and cancel rows. It is NEVER a production deployment:
#   - the mode is this sheet line and nothing else (no flag, no environment variable); production is the default when the line is absent and keeps the 172800 s floor
#   - TIMELOCK_MIN_DELAY must be 900 to 172799 here; a production sheet must be 172800 or more
#   - the release tag must be release/<version>-rehearsal (a production tag never satisfies it)
# The caps, NAV guards and pool liquidity floors below are the Twin values: take the 8453 values from the first rehearsal sheet before a real run.
# PUBLIC ADDRESSES ONLY. The role and Safe owner lines below are PLACEHOLDERS: the operator types the real public addresses of the keys it reuses (deployer, pauser, emergency, Safe owners A, B, C).
# No key, passphrase, keystore path or earlier Safe address belongs in this file. SAFE_SALT_NONCE must be a value no earlier run used: the same owners, threshold and salt predict the Safe that
# already exists, and the run refuses a predicted Safe that already holds code (SAFE_SALT_NONCE_REUSED).
# Stage sheet for the Twin chain (918453): parameter lines for the publish-contracts CLI (bun publish-contracts/src/cli.ts). Owned by core.
# The identity lines (roles, Safe owners, voters) below are placeholders. The harness replaces them per run with the addresses of fresh throwaway keystores.
# No secret belongs in this file. Same names as a production sheet: only the values differ.

# --- chain: both must equal `cast chain-id` of the RPC ---
CHAIN_ID=8453
EXPECTED_CHAIN_ID=8453

# --- roles. Every address is different. Safe owners are separate from the role keys. ---
ADMIN_ADDRESS=0x000000000000000000000000000000000000a001        # the deployer: in a rehearsal it need NOT be fresh (its start nonce is recorded in the run manifest at the first stage), holds nothing after the timelock stage
PAUSER_ADDRESS=0x000000000000000000000000000000000000a002
EMERGENCY_ADDRESS=0x000000000000000000000000000000000000a003
SHARE_RECEIVER_ADDRESS=0x000000000000000000000000000000000000a005
RECEIPT_ADMIN_ADDRESS=0x000000000000000000000000000000000000a001   # must equal ADMIN_ADDRESS: DeployInvestmentCommitteePolicy gives the receipt roles to it, the deployer revokes them in the timelock stage
VOTER_ADDRESSES=0x000000000000000000000000000000000000b001,0x000000000000000000000000000000000000b002
VOTER_POWER=1000
SAFE_OWNERS=0x000000000000000000000000000000000000c001,0x000000000000000000000000000000000000c002,0x000000000000000000000000000000000000c003
SAFE_THRESHOLD=2                       # 2 .. N-1
SAFE_VERSION=1.4.1                     # optional. 1.4.1 is the only version.

# --- economics ---
FEE_RECIPIENT_ADDRESS=@safe            # the created Safe, or another treasury address. Never the deployer.
SEED_DEPOSIT_USDC=1000000              # rmUSDC only: 1 USDC in 6-decimal units
VAULT_NAME="Robot Money USDC"          # registered name of the rmUSDC vault in the registry (core registry stage VAULT_NAME, no default)
SWAP_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481   # Uniswap V3 SwapRouter02 on Base, the basket vaults' swap router (core SWAP_ROUTER)
VAULT_USDC_TVL_CAP=1000000000          # per-vault names carry the vault key: USDC, PROTO, AGENT, RWA
VAULT_USDC_PER_DEPOSIT_CAP=100000000
VAULT_USDC_EXIT_FEE_BPS=0
VAULT_PROTO_TVL_CAP=1000000000
VAULT_PROTO_PER_DEPOSIT_CAP=100000000
VAULT_PROTO_EXIT_FEE_BPS=0
VAULT_PROTO_NAV_DEVIATION_BPS=100      # basket only (not USDC): ORA-4 deposit guard in basis points, 1 to 2000. 0 disables it and is refused.
VAULT_PROTO_MIN_POOL_LIQUIDITY=10000000000   # basket only: floor for pool.liquidity() (uint128 L, NOT USDC) of every pool. Twin: below live Base cbBTC pool 2.6e12, wETH 1.0e18
# rmAGENT trades RM on the Uniswap V4 RM/USDC 2.91% pool (core 1676). The first Base mainnet run is a contained TEST, not the final deployment: 1 USDC seed, low TVL and per-deposit caps below the pool depth,
# a nonzero NAV deviation guard, pause available, no announcement until the governance checks pass. The Twin caps below are not the 8453 caps (an owner action).
VAULT_AGENT_TVL_CAP=1000000000
VAULT_AGENT_PER_DEPOSIT_CAP=100000000
VAULT_AGENT_EXIT_FEE_BPS=0
VAULT_AGENT_NAV_DEVIATION_BPS=100
VAULT_AGENT_MIN_POOL_LIQUIDITY=1000000000000000   # Twin: the live RM V4 pool holds L about 1e18 at the pin and is never funded (owner decision 2026-10-09); the floor (liquidity L, not USDC) is below it
VAULT_RWA_TVL_CAP=1000000000
VAULT_RWA_PER_DEPOSIT_CAP=100000000
VAULT_RWA_EXIT_FEE_BPS=0
VAULT_RWA_NAV_DEVIATION_BPS=100
VAULT_RWA_MIN_POOL_LIQUIDITY=1000000000000   # Twin: below live Base deSPXA pool 2.2e18

# --- governance ---
QUORUM_THRESHOLD=2                     # above 1 on every chain
VOTING_PERIOD=3600                     # at least 3600 on every chain
EXECUTION_DELAY=3600                   # at least 3600 on every chain
TIMELOCK_MIN_DELAY=900                 # rehearsal kind: 900 to 172799. A production sheet is 172800 or more on chain id 8453.
DEPLOYMENT_KIND=rehearsal              # explicit and sheet-only. Absent means production.
SAFE_SALT_NONCE=20261010               # CHANGE IT: a value no earlier run used (required in a rehearsal)

# --- deploy-time router configuration (issue 1520). Set by the deployer in the basket vault stages, before the timelock handover. Lists of vault keys, or the word none. ---
ELIGIBLE_VAULTS=PROTO,AGENT,RWA           # baskets made router-eligible by migrateEligibility in their own stage. rmUSDC is eligible from the router stage.
ROUTER_WEIGHTS=USDC:9500,PROTO:500,AGENT:0,RWA:0   # the router default weights: rmUSDC and each eligible basket, bps summing to 10000. The last eligible basket stage leaves exactly this vector.

# --- govern stage (stage 13). On 8453 the only operation after the handover is the unpause of the four vaults: one timelock operation per vault listed here. ---
GOVERN_UNPAUSE_VAULTS=USDC,PROTO,AGENT,RWA   # which vaults the Safe unpauses: all four (they all deploy paused), as stage 13 does on 8453, all scheduled in one sitting, one 48 hour wait.
GOVERN_NEW_DELAY=1800                  # the update-delay row target (rehearsal only on 8453): 900 to 172799 in a rehearsal.
