# Deploy 3 sheet fragment (Base 8453, a rehearsal-kind run, release v0.5.0). PUBLIC ADDRESSES AND NUMBERS ONLY: no key, passphrase or keystore path.
# The contract QA runbook (docs/runbooks/contract-qa/releases/v0.5.0.yaml, P0.52) copies this file to {runDir}/fragment.env.
# P0.15 merges it over stage-sheet.example.env. P0.51 then sets UPGRADE_MODE=upgradeable. No line is typed by hand at run time.
# Source: the reviewed Deploy 2 sheet (release/v0.4.0-base-rehearsal), the original in run 2's evidence folder on the operator machine,
# ~/robotmoney-evidence/base-mainnet-r900/sheet.env. A rehearsal reuses the first rehearsal's keys (runbook 4.10): the same deployer,
# pauser, emergency key and Safe owners A, B and C. The Safe owners match deployments/8453/deploy-2/safe.json.

# --- roles: the reused keys ---
ADMIN_ADDRESS=0xf3F582464De7BD2cBf9d2ad40429e31D0F4724A3
PAUSER_ADDRESS=0x9CF20aDf86aD3Ca5a259902Ee4f7e472aAf0F146
EMERGENCY_ADDRESS=0x2c76f2f8753880AA88910A97f97Ae9B15b465Dab
SHARE_RECEIVER_ADDRESS=0xa5dAD878b268bCf5c31E61b3bd665AEF61feA5CE
RECEIPT_ADMIN_ADDRESS=0xf3F582464De7BD2cBf9d2ad40429e31D0F4724A3
SAFE_OWNERS=0xa5dAD878b268bCf5c31E61b3bd665AEF61feA5CE,0x5c6b2a1fa3A59aCc9C943Cc93FAD204fBfB0935a,0xB3cAbaD71CE97f582DCfdB5966294b8e4B7B7180
SAFE_THRESHOLD=2

# --- the Deploy 2 8453 caps that differ from the example sheet ---
VAULT_AGENT_TVL_CAP=20000000
VAULT_AGENT_PER_DEPOSIT_CAP=5000000
# VAULT_AGENT_NAV_DEVIATION_BPS stays at the example's 400. Deploy 2 used 100. The agent stage refuses a guard at or below the pool fee (30 bps for BNKR, 291 bps for RM).

# --- a new Safe salt: Deploy 2 used 2026101002. The Safe stage refuses a predicted Safe that already holds code (SAFE_SALT_NONCE_REUSED). ---
SAFE_SALT_NONCE=2026101603
