# Deploy 3 (v0.5.0) upgrade-mode overlay for the Base mainnet rehearsal (8453), owner decision 2026-10-16.
# The committed rehearsal example (stage-sheet.example.env) stays UPGRADE_MODE=frozen. Deploy 3 is an upgradeable
# proving period, so its runbook (docs/runbooks/contract-qa/releases/v0.5.0.yaml, P0.51) merges this line over the
# run sheet. A rehearsal needs no UPGRADE_FREEZE_DEADLINE (runbook 4.12). Later lines win in merge-sheet. No secret
# belongs in this file.
UPGRADE_MODE=upgradeable
