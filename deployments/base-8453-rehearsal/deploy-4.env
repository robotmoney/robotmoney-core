# Deploy 4 sheet (Base 8453, a rehearsal-kind run of the fund system: the one-vault prototype, owner exception 2026-11-12).
# PUBLIC ADDRESSES AND NUMBERS ONLY: no key, passphrase or keystore path.
# The fund system has its own sheet (publish-contracts --system fund, src/sheet.ts FUND_SHEET_NAMES): this file is the whole sheet,
# not a fragment over stage-sheet.example.env, because the fund sheet refuses every vault, router and gateway name.
# Keys: the Deploy 3 keys (deployments/base-8453-rehearsal/deploy-3.env), read from the keystores' public address fields.
# Rehearsal rules (runbook 4.10, validate-contract-qa.ts): delay 900 s, seed exactly 1 USDC, every cap at most 1,000 USDC, 3 Safe owners, a new salt.

# --- chain and kind ---
CHAIN_ID=8453
EXPECTED_CHAIN_ID=8453
DEPLOYMENT_KIND=rehearsal
UPGRADE_MODE=upgradeable
TIMELOCK_MIN_DELAY=900

# --- roles: the Deploy 3 keys ---
ADMIN_ADDRESS=0xf3F582464De7BD2cBf9d2ad40429e31D0F4724A3
RECEIPT_ADMIN_ADDRESS=0xf3F582464De7BD2cBf9d2ad40429e31D0F4724A3
PAUSER_ADDRESS=0x9CF20aDf86aD3Ca5a259902Ee4f7e472aAf0F146
# The emergency key holds only the pauses (fund pauseDeposits, pauseRebalance; queue pauseQueue, freezeSettlement). shutdown and
# emergencyUnwind are the timelock's (owner, 2026-11-13).
EMERGENCY_ADDRESS=0x2c76f2f8753880AA88910A97f97Ae9B15b465Dab
SAFE_OWNERS=0xa5dAD878b268bCf5c31E61b3bd665AEF61feA5CE,0x5c6b2a1fa3A59aCc9C943Cc93FAD204fBfB0935a,0xB3cAbaD71CE97f582DCfdB5966294b8e4B7B7180
SAFE_THRESHOLD=2
# The keeper (settle and step, keeper first): the owner's new keeper key, public address only (owner decision 2026-11-13).
KEEPER_ADDRESS=0x75E3f84949d5e0aB621EEb06537A1a944274768B

# --- a new Safe salt: Deploy 2 used 2026101002, Deploy 3 2026101603. A new Safe predicts a new timelock address. ---
# The Safe is also the fund timelock's only executor (decision D4-10, FundTimelockPolicy.sol): the executor is part of the timelock's
# CREATE2 init code, so this branch predicts a different fund timelock than the live Deploy 4 one for the same Safe and delay.
SAFE_SALT_NONCE=2026111201

# --- the fund (DeployFund.s.sol) ---
FEE_RECIPIENT_ADDRESS=@safe
SWAP_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481
FUND_TVL_CAP=1000000000
FUND_PER_DEPOSIT_CAP=100000000
FUND_EXIT_FEE_BPS=10
FUND_MAX_SLIPPAGE_BPS=200
FUND_NAV_DEVIATION_BPS=200
FUND_LENDING_CAP_BPS=6000
FUND_MIN_SEED_USDC=1000000
SEED_DEPOSIT_USDC=1000000

# --- the rebalancer (DeployRebalancer.s.sol), proposal 5.6 suggested starts ---
REBALANCER_KEEPER_GRACE=21600
REBALANCER_MAX_OVERRUN=604800
REBALANCER_MAX_STEP_COST_BPS=50
REBALANCER_TOLERANCE_BPS=50
# Rehearsal sizing (D4-4, owner 2026-11-13): 1 USDC (the default is 100 USDC), so steps trade while NAV is at most 1,000 USDC.
REBALANCER_MIN_STEP_USDC=1000000
REBALANCER_LENDING_MAX_STEP_USDC=500000000000
REBALANCER_MAJOR_MAX_STEP_USDC=50000000000
REBALANCER_MAJOR_SLIPPAGE_OVER_FEE_BPS=45
# Set by Rebalancer.initialize (stepDepthBps, 5); no stage sets it, the fund verifier reads it back.
REBALANCER_STEP_DEPTH_BPS=5

# --- the default plan (DeployRebalanceGovernance.s.sol) ---
# Rehearsal sizing (D4-4, owner 2026-11-13): 1 day, the minimum (the default is 7 days), so the keeper-step rows finish inside the QA window.
PLAN_DURATION=86400
PLAN_COST_BUDGET_BPS=30

# --- the queue's flow parameters (DeployFlowQueue.s.sol), proposal 5.9.5 defaults except the rehearsal sizes ---
FLOW_EPOCH_LENGTH=21600
FLOW_SETTLE_WINDOW=3600
# Owner, 2026-11-13 (decision D4-11): a 1 hour deposit hold, the new default and the contract floor.
FLOW_MIN_HOLD=3600
FLOW_KEEPER_GRACE=21600
FLOW_MAX_EPOCH_FLOW_BPS=500
# Rehearsal size: 100 USDC (the default is 250,000 USDC).
FLOW_EPOCH_FLOOR_USDC=100000000
FLOW_MAX_SHARE_PRICE_MOVE_BPS=1000
FLOW_MAX_ROLL=8
# Rehearsal size: 1 USDC (the default is 100 USDC).
FLOW_MIN_REQUEST_USDC=1000000
FLOW_MAX_FREEZE=604800
FLOW_SLICES=12
FLOW_QUORUM=9
FLOW_DISPERSION_BPS=100
FLOW_REF_BAND_BPS=90
FLOW_LEG_BAND_BPS=100
FLOW_SEQUENCER_GRACE=3600
FLOW_USDC_PEG_BAND_BPS=50
FLOW_MAX_LEND_RATE_GROWTH_BPS=10
# Set by FlowQueue.initialize (FlowLevers.basketCallBps, 5); no stage sets it, the fund verifier reads it back.
FLOW_BASKET_CALL_BPS=5
