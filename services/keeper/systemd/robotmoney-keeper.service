# One-vault keeper service (docs/technical/one-vault-rebalancer-proposal.md §8.1.5).
# Install: copy to /etc/systemd/system/, the checkout to /opt/robotmoney-keeper (run `bun install` in services/keeper),
# the config to /etc/robotmoney-keeper/keeper.toml, and the keystore password to /etc/robotmoney-keeper/password
# (root:root 0600). systemd hands the password over through LoadCredential=: it never sits in this unit, an argument,
# or the environment.
[Unit]
Description=Robot Money one-vault keeper (settle, step, stepDelisted)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=robotmoney-keeper
LoadCredential=keeper-password:/etc/robotmoney-keeper/password
LoadCredential=keeper-keystore:/etc/robotmoney-keeper/keeper.keystore
Environment=KEEPER_PASSWORD_FILE=%d/keeper-password
Environment=KEEPER_KEYSTORE=%d/keeper-keystore
Environment=KEEPER_STATE_DIR=%S/robotmoney-keeper
ExecStart=/usr/local/bin/bun /opt/robotmoney-keeper/services/keeper/src/cli.ts --config /etc/robotmoney-keeper/keeper.toml
Restart=on-failure
RestartSec=10
# Exit 2 is bad config, a failed start-up check, or a second instance: a restart will not fix it.
RestartPreventExitStatus=2
# A send in flight waits for its receipt (receiptTimeoutSecs) before the process exits 0.
KillSignal=SIGTERM
TimeoutStopSec=180
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
